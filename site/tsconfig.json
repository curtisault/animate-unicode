{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "animate-unicode": [
        "../web/src/index.ts"
      ],
      "animate-unicode/element": [
        "../web/src/element.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
